# TokoBoss Mobile environment (copy to `.env` — never commit secrets).
#
# Only EXPO_PUBLIC_* values are read by the app; they ship in the client
# bundle, so NEVER put tokens, passwords, or provider secrets here.

# dev | staging | preview (default: dev)
EXPO_PUBLIC_APP_ENV=dev

# BFF base URL. Defaults to http://localhost:3000 in dev.
# REQUIRED for staging/preview — no production-like URL is hardcoded.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
