{
  "name": "@tokoboss/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "echo \"Database lint stub\" && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "node scripts/check-migrations.ts",
    "db:migrate": "node scripts/migrate.ts",
    "db:migrate:prod": "node scripts/migrate.ts --prod",
    "db:seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@tokoboss/domain": "workspace:*",
    "@neondatabase/serverless": "^1.0.0",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.3"
  }
}
