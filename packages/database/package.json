{
  "name": "@tokoboss/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "echo \"Database lint stub\" && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "tsc && node dist/scripts/check-migrations.js",
    "db:migrate": "tsc && node dist/scripts/migrate.js",
    "db:migrate:prod": "tsc && node dist/scripts/migrate.js --prod",
    "db:seed": "tsc && node dist/scripts/seed.js"
  },
  "dependencies": {
    "@tokoboss/domain": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.15.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.3"
  }
}
