# TokoBoss Web Application Environment Variables
#
# Copy this file to .env.local for local development.
# See /.env.example (repository root) for full documentation.

# ============================================
# Application Environment
# ============================================
APP_ENV=local

# ============================================
# Public Variables (Client-Side)
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# ============================================
# Server-Only Variables
# ============================================
NODE_ENV=development

# Database (when UTA-10 lands)
# DATABASE_URL=postgresql://user:password@localhost:5432/tokoboss_dev

# Vercel Blob (when UTA-10 lands)
# BLOB_READ_WRITE_TOKEN=

# See /.env.example for additional variables and documentation
