# TokoBoss Environment Variables
#
# This file contains examples of environment variables used in TokoBoss.
# Copy this file to .env.local for local development and fill in your values.
#
# IMPORTANT: Never commit real secrets to git!
#
# See infra/vercel/README.md for full documentation.

# ============================================
# Application Environment
# ============================================
# Options: production, staging, preview, local
APP_ENV=local

# ============================================
# Public Variables (Exposed to Client)
# ============================================
# These variables are prefixed with NEXT_PUBLIC_ and will be
# embedded in the client bundle. NEVER put secrets here!

# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment displayed to users
# Options: production, staging, preview, local
NEXT_PUBLIC_APP_ENV=local

# ============================================
# Server-Only Variables
# ============================================
# These variables are only available in server-side code
# and should contain secrets/credentials.

# Node environment (set automatically by Next.js)
NODE_ENV=development

# Vercel-specific variables (automatically set by Vercel)
# VERCEL_ENV=preview
# VERCEL_DEPLOYMENT_ID=dpl_xxxxx
# VERCEL_GIT_COMMIT_SHA=abc123
# VERCEL_REGION=sin1
# VERCEL_URL=tokoboss-xyz.vercel.app

# ============================================
# Database (UTA-10: Neon Postgres + Drizzle)
# ============================================
# Neon Postgres connection strings. Each environment uses its own branch —
# preview must NEVER use production credentials (see infra/neon/README.md).
#
# DATABASE_URL      — direct connection (used by db:migrate / db:migrate:prod, max: 1)
# DATABASE_POOL_URL — pooled connection (used by the runtime adapter)
# Local: point at the Neon `dev` branch or a local Postgres.
# Tests/seeds never read production credentials (see packages/database/src/seed.ts).

# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/tokoboss_dev?sslmode=require
# DATABASE_POOL_URL=postgresql://user:password@ep-xxxx-pooler.neon.tech/tokoboss_dev?sslmode=require&pgbouncer=true

# ============================================
# Vercel Blob Storage (UTA-10+)
# ============================================
# Production: Use production blob storage token (NEVER in preview!)
# Staging: Use staging blob storage token
# Preview: Use preview blob storage token (isolated from production)
# Local: Use local or development blob storage

# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# ============================================
# Third-Party Integrations (Future)
# ============================================
# Marketplace/SaaS API keys
# Production: Real API keys
# Staging: Staging/test API keys
# Preview: Sandbox API keys (NEVER use production keys!)
# Local: Development API keys

# MARKETPLACE_API_KEY=
# MARKETPLACE_API_SECRET=

# ============================================
# Billing & Payments (Future)
# ============================================
# Payment provider credentials
# Production: Real payment credentials (NEVER in preview!)
# Staging: Test mode credentials
# Preview: Should NOT be set
# Local: Test mode credentials

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================
# Security & Signing Keys (Future)
# ============================================
# JWT signing keys, encryption keys, etc.
# Production: Production keys (NEVER in preview!)
# Staging: Staging keys
# Preview: Should NOT be set or use development keys
# Local: Development keys

# JWT_SECRET=
# ENCRYPTION_KEY=

# ============================================
# Observability (Future)
# ============================================
# Logging, monitoring, APM services

# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# DATADOG_API_KEY=

# ============================================
# Notes
# ============================================
#
# 1. Environment Isolation:
#    - Preview deployments must NEVER have production credentials
#    - Each environment should have separate databases, storage, and API keys
#    - See infra/vercel/README.md for isolation rules
#
# 2. Setting Variables:
#    - Local: Copy to .env.local and fill in values
#    - Vercel: Set in Project Settings → Environment Variables
#    - See infra/vercel/PROJECT_SETTINGS.md for Vercel configuration
#
# 3. Security:
#    - Never commit .env.local or .env.*.local files
#    - Never log secrets or expose them in error messages
#    - Only NEXT_PUBLIC_* variables can be used in client code
#
# 4. Validation:
#    - Environment variables are validated at server startup
#    - Invalid configuration will prevent the server from starting
#    - See packages/config/env.ts for validation rules
